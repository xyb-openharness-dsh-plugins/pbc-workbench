{
  "name": "@ductpal-dsh/pbc-workbench",
  "version": "0.2.9",
  "description": "原发性胆汁性胆管炎（PBC）患者工作台：把生化序列、治疗与应答记录、乏力瘙痒与并发症筛查整理成可核对、可带去门诊的资料（本机优先）",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "schema",
    "assets",
    "demo/build-demo-data.mjs",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "research/pbc-cancer/pbc_cancer_trials_2026.sqlite"
  ],
  "scripts": {
    "check": "npm run build-version && npm run build-public && npm run build-demo && node scripts/check-version.mjs && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-demo-columns.mjs && node scripts/build-client.mjs --check && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-host-contract.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-primer-links.mjs",
    "check-host": "node scripts/check-host-contract.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run test && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "probe:primer": "node scripts/probe-disease-primer.mjs",
    "demo:data": "node demo/build-demo-data.mjs",
    "probe:proto": "python3 scripts/probe-prototype.py",
    "shots:readme": "python3 scripts/shoot-readme.py",
    "build-version": "node scripts/build-version.mjs",
    "build-public": "node scripts/build-public.mjs",
    "build-client": "node scripts/build-client.mjs",
    "build-demo": "node demo/build-demo-data.mjs",
    "check-version": "node scripts/check-version.mjs",
    "check-syntax": "node scripts/check-syntax.mjs",
    "check-schema": "node scripts/check-schema.mjs",
    "check-wording": "node scripts/check-wording.mjs",
    "check-demo-columns": "node scripts/check-demo-columns.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "check-package": "node scripts/check-workbench-package.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/pbc-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
